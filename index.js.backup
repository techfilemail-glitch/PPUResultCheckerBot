);

function createAsyncQueue(concurrency = 1) {
  const limit = Math.max(1, Number(concurrency) || 1);

  const pending = [];
  const allPromises = [];
  let active = 0;

  function pump() {
    while (active < limit && pending.length) {
      const item = pending.shift();

      active++;

      Promise.resolve()
        .then(() => item.task())
        .then(item.resolve, item.reject)
        .finally(() => {
          active--;
          pump();
        });
    }
  }

  function add(task) {
    let resolveOuter;
    let rejectOuter;

    const promise = new Promise((resolve, reject) => {
      resolveOuter = resolve;
      rejectOuter = reject;
    });

    pending.push({
      task,
      resolve: resolveOuter,
      reject: rejectOuter,
    });

    allPromises.push(promise);

    pump();

    return promise;
  }

  async function drain() {
    if (!allPromises.length) {
      return [];
    }

    return Promise.allSettled(allPromises);
  }

  return { add, drain };
}

/*
=========================================================
DROPDOWN DATA (session / exam / course)

Only the single cache inside result-checker.js is used here.
=========================================================
*/

function normalizeCacheKey(value) {
  return String(value || "")
    .trim()
    .replace(/\s+/g, " ")
    .toLowerCase();
}

function normalizeDropdownItem(item) {
  if (item === null || item === undefined) {
    return null;
  }

  if (typeof item === "string" || typeof item === "number") {
    const value = String(item).trim();
    return { value, text: value };
  }

  if (typeof item === "object") {
    const value = String(
      item.value ?? item.id ?? item.text ?? item.name ?? ""
    ).trim();

    const text = String(
      item.text ?? item.name ?? item.label ?? item.value ?? item.id ?? ""
    ).trim();

    if (!value && !text) {
      return null;
    }

    return {
      ...item,
      value: value || text,
      text: text || value,
    };
  }

  return null;
}

function normalizeDropdownArray(data) {
  if (!Array.isArray(data)) {
    return [];
  }

  return data.map(normalizeDropdownItem).filter(Boolean);
}

function findDropdownItem(array, value) {
  const target = normalizeCacheKey(value);

  return (
    array.find(
      (item) =>
        normalizeCacheKey(item?.value) === target ||
        normalizeCacheKey(item?.text) === target
    ) || null
  );
}

async function getSessionsCached() {
  const data = normalizeDropdownArray(await getSessions());

  if (!data.length) {
    throw new Error("Portal returned no sessions.");
  }

  return data;
}

async function getExamTypesCached(session) {
  const data = normalizeDropdownArray(await getExamTypes(session));

  if (!data.length) {
    throw new Error(`No exam types returned for ${session}.`);
  }

  return data;
}

async function getCoursesCached(session, examType) {
  let actualExamType = examType;

  try {
    const matched = findDropdownItem(await getExamTypes(session), examType);

    if (matched) {
      actualExamType = matched.value || matched.text || examType;
    }
  } catch (_) {}

  const data = normalizeDropdownArray(await getCourses(session, actualExamType));

  if (!data.length) {
    throw new Error(`No courses returned for ${session} / ${actualExamType}.`);
  }

  return data;
}

