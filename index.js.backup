/* /bulksubject → straight to the session step */
bot.onText(/^\/bulksubject(?:@\w+)?$/i, async (msg) => {
  const chatId = msg.chat.id;

  if (!isBulkAllowed(msg.from?.id)) {
    return bot.sendMessage(chatId, MSG.bulkOwnerOnly, { parse_mode: "HTML" });
  }

  try {
    await openBulkSubject(chatId, msg.from.id);
  } catch (error) {
    console.error("/bulksubject error:", error);

    await clearResultProcess(chatId);

    bot.sendMessage(
      chatId,
      "❌ <b>Subject Bulk Could Not Start</b>\nPlease try again.",
      {
        parse_mode: "HTML",
      }
    );
  }
});

bot.onText(/^\/bulkcollege(?:@\w+)?$/i, async (msg) => {
  const chatId = msg.chat.id;

  if (!isBulkAllowed(msg.from?.id)) {
  return bot.sendMessage(
    chatId,
    "👤 <b>Profile Setup Required</b>\n\nPlease complete your profile setup first to use Bulk Result.",
    { parse_mode: "HTML" }
  );
}

  try {
    const oldState = userState.get(chatId);

    if (oldState?.messageId) {
      await deleteBotMessage(chatId, oldState.messageId);
    }

    userState.set(chatId, {
      mode: "bulk",
      bulkType: "college",
      ownerId: String(msg.from.id),
      messageId: null,
      bulkMessageId: null,
      collegeBulkRunning: false,
    });

    if (typeof bulkCollege.start === "function") {
      return await bulkCollege.start(bot, userState, chatId);
    }

    return bot.sendMessage(
      chatId,
      "❌ <b>Module Unavailable</b>\nThe college bulk module is not available.",
      { parse_mode: "HTML" }
    );
  } catch (error) {
    console.error("/bulkcollege error:", error);

    return bot.sendMessage(
      chatId,
      "❌ <b>College Bulk Could Not Start</b>\nPlease try again.",
      {
        parse_mode: "HTML",
      }
    );
  }
});

bot.onText(/^\/bulk(?:@\w+)?$/, async (msg) => {
  const chatId = msg.chat.id;

  if (!isBulkAllowed(msg.from?.id)) {
  return bot.sendMessage(
    chatId,
    "👤 <b>Profile Setup Required</b>\n\nPlease complete your profile setup first to use Bulk Result.",
    { parse_mode: "HTML" }
  );
}

  try {
    if (collegeBulkRunningChats.has(chatId)) {
      return bot.sendMessage(chatId, MSG.bulkRunning, {
        parse_mode: "HTML",
      });
    }

    await clearResultProcess(chatId);

    userState.set(chatId, {
      mode: "bulk",
      bulkType: null,
      bulkStep: "menu",
      ownerId: String(msg.from.id),
      messageId: null,
      bulkMessageId: null,
    });

    return bot.sendMessage(
      chatId,
      "📦 <b>Bulk Result</b>\n\nPlease choose a bulk mode.",
      {
        parse_mode: "HTML",
        ...bulkMenu(),
      }
    );
  } catch (error) {
    console.error("/bulk error:", error);

    return bot.sendMessage(
      chatId,
      "❌ <b>Bulk Menu Unavailable</b>\nThe bulk menu could not be opened. Please try again.",
      {
        parse_mode: "HTML",
        ...ownerMenu(),
      }
    );
  }
});

bot.on("message", async (msg) => {
  if (!msg.text) {
    return;
  }

  const chatId = msg.chat.id;

  const text = msg.text.trim();

  if (text.startsWith("/")) {
    return;
  }

  const state = userState.get(chatId);

  if (!state) {
    return;
  }

  if (state.mode === "profile") {
    return handleProfileMessage(chatId, state, text, msg);
  }

  if (state.mode === "bulk") {
    const currentUserId = String(msg.from?.id ?? "").trim();

    const stateOwnerId = String(state.ownerId ?? "").trim();

    const authorized = isBulkMessageAllowed(msg, state);

    if (!authorized) {
      console.log(
        `🔒 Unauthorized bulk message blocked → ${currentUserId} | state owner: ${stateOwnerId}`
      );

      return;
    }

    try {
      const handledBySubject = await bulkSubject.handleMessage(
        bot,
        userState,
        msg
      );

      if (handledBySubject) {
        return;
      }

      const handledByCollege = await bulkCollege.handleMessage(
        bot,
        userState,
        msg
      );

      if (handledByCollege) {
        return;
      }
    } catch (error) {
      console.error("Bulk message error:", error);

      await clearResultProcess(chatId);

      return bot.sendMessage(
        chatId,
        `❌ <b>Bulk Result Error</b>
Your input could not be processed.
Please start again using /bulk.`,
        {
          parse_mode: "HTML",
          ...mainMenu(chatId),
        }
      );
    }

    return;
  }

  if (state.step !== "roll") {
    return;
  }

  let roll = text;

  if (OWN_ROLL_ONLY && !isOwnerMessage(msg)) {
    const ownProfile = profiles.getByTelegramId(msg.from?.id);

    if (!ownProfile) {
      return startProfileSetup(chatId, msg.from);
    }

    roll = ownProfile.roll;
  }

  if (!/^\d{5,20}$/.test(roll)) {
    return bot.sendMessage(chatId, MSG.invalidRoll, {
      parse_mode: "HTML",
    });
  }
  if (
    isRateLimited(msg.from?.id, Number(process.env.RESULT_RATE_LIMIT || 5))
  ) {
    return bot.sendMessage(chatId, MSG.rateLimited, { parse_mode: "HTML" });
  }
  return runRollCheck(chatId, state, roll, msg.from?.id);
});

/* =========================================================
   STUDENT PROFILE / LOCKER
========================================================= */

const lockerRunning = new Set();

function profileButtons(chatId) {
  return {
    reply_markup: {
      inline_keyboard: colorRows([
        { text: "🔐 My Locker", callback_data: "MY_LOCKER" },
        { text: "📊 Check Result", callback_data: "CHECK_RESULT" },
        { text: "🏠 Main Menu", callback_data: "MAIN_MENU" },
      ]),
    },
  };
}

/* =========================================================
   /delprofile  (a user can remove their own saved profile)
========================================================= */

async function askDeleteProfile(chatId, userId) {
  const profile = profiles.getByTelegramId(userId);

  if (!profile) {
    return bot.sendMessage(
      chatId,
      "ℹ️ <b>No Profile Found</b>\n\nYou do not have a saved profile. Send /profilesetup to create one.",
      { parse_mode: "HTML" }
    );
  }

  if (lockerRunning.has(String(userId))) {
    return bot.sendMessage(
      chatId,
      "⏳ <b>Your locker is still loading.</b>\nPlease send /delprofile again once it has finished.",
      { parse_mode: "HTML" }
    );
  }

  return bot.sendMessage(
    chatId,
    "🗑️ <b>Delete Profile?</b>\n\n" +
      "Your saved profile details will be removed from this bot, including your roll number, name and academic details.\n\n" +
      "You can create a new profile at any time using /profilesetup.\n\n" +
      `Roll Number: <code>${escapeHtml(profile.roll)}</code>`,
    {
      parse_mode: "HTML",
      reply_markup: {
        inline_keyboard: [
          [
            {
              text: "✅ Yes, Delete",
              callback_data: "DELPROFILE_YES",
              style: "danger",
            },
            {
              text: "↩️ Keep Profile",
              callback_data: "DELPROFILE_NO",
              style: "success",
            },
          ],
        ],
      },
    }
  );
}

async function confirmDeleteProfile(chatId, userId) {
  const key = String(userId);

  if (lockerRunning.has(key)) {
    return bot.sendMessage(
      chatId,
      "⏳ <b>Your locker is still loading.</b>\nPlease try again in a moment.",
      { parse_mode: "HTML" }
    );
  }

  // Only the requesting user's own profile (matched by Telegram ID).
  const removed = await profiles.removeSelf(userId);

  if (!removed) {
    return bot.sendMessage(
      chatId,
      "ℹ️ <b>Profile Already Removed</b>\nThere is no saved profile on this account.",
      {
        parse_mode: "HTML",
      }
    );
  }

  // Clear any remaining in-memory data for this roll.
  forgetRoll(removed.roll);

  try {
    require("./full-scan").forgetRoll(removed.roll);
  } catch (_) {}

  userState.delete(chatId);

  return bot.sendMessage(
    chatId,
    "✅ <b>Profile Deleted</b>\n\nYour saved profile details have been removed.\n\nSend /profilesetup whenever you would like to create a new profile.",
    {
      parse_mode: "HTML",
      ...(isOwner(userId) ? ownerMenu() : mainMenu(chatId)),
    }
  );
}

async function startRollReset(chatId, from) {
  const userId = from?.id ?? chatId;

  const existing = profiles.getByTelegramId(userId);

  if (!existing) {
    return startProfileSetup(chatId, from);
  }

  if (!isOwner(userId) && studentProfile.rollChangesLeft(existing) <= 0) {
    return bot.sendMessage(
      chatId,
      `🚫 <b>Change Limit Reached</b>\nA roll number can be updated up to ${studentProfile.MAX_ROLL_CHANGES} times, and this limit has been used.`,
      { parse_mode: "HTML", ...mainMenu(chatId) }
    );
  }

  const left = isOwner(userId)
    ? "unlimited"
    : `${studentProfile.rollChangesLeft(existing)} / ${studentProfile.MAX_ROLL_CHANGES}`;

  return startProfileSetup(chatId, from, { reset: true, left });
}

async function startProfileSetup(chatId, from, opts = {}) {
  const userId = from?.id ?? chatId;

  const existing = profiles.getByTelegramId(userId);

  if (existing && !isOwner(userId) && !opts.reset) {
    return bot.sendMessage(
      chatId,
      `✅ <b>Your profile is already set up.</b>\nTo update your roll number, use /resetroll (up to ${studentProfile.MAX_ROLL_CHANGES} times).`,
      {
        parse_mode: "HTML",
        ...mainMenu(chatId),
      }
    );
  }

  await clearResultProcess(chatId);

  const sent = await bot.sendMessage(
    chatId,
    `🧾 <b>${opts.reset ? "Update Roll Number" : "Profile Setup"}</b>${
      opts.reset ? `\n🔁 Changes remaining: <b>${opts.left}</b>` : ""
    }

Please send your <b>13-digit university roll number</b>.
(Printed on your admit card.)

Example:
<code>2620641060085</code>`,
    {
      parse_mode: "HTML",
      reply_markup: {
        inline_keyboard: [
          [{ text: "❌ Cancel", callback_data: "PROFILE_CANCEL", style: "danger" }],
        ],
      },
    }
  );

  userState.set(chatId, {
    mode: "profile",
    step: "roll",
    messageId: sent.message_id,
    userId: String(userId),
    username: from?.username || "",
    reset: Boolean(opts.reset),
  });
}

async function handleProfileMessage(chatId, state, text, msg) {
  if (state.step !== "roll") {
    return;
  }

  if (!/^\d{13}$/.test(text)) {
    return bot.sendMessage(chatId, MSG.invalidProfileRoll, {
      parse_mode: "HTML",
    });
  }

  if (isRateLimited(msg.from?.id, 5, 60 * 1000, "profile")) {
    return bot.sendMessage(chatId, MSG.rateLimited, { parse_mode: "HTML" });
  }

  state.step = "building";

  userState.set(chatId, state);

  const waiting = await bot.sendMessage(
    chatId,
    "⏳ <b>Setting Up Your Profile</b>\nPlease wait a moment while your details are verified.",
    { parse_mode: "HTML" }
  );

  try {
    const result = await studentProfile.createProfile({
      telegramId: msg.from?.id ?? chatId,
      username: msg.from?.username || "",
      roll: text,
      unlimited: isOwner(msg.from?.id),
    });

    await deleteBotMessage(chatId, waiting.message_id);

    if (!result.ok && result.limitReached) {
      await clearResultProcess(chatId);

      return bot.sendMessage(
        chatId,
        `🚫 <b>Change Limit Reached</b>\n${escapeHtml(result.message)}`,
        { parse_mode: "HTML", ...mainMenu(chatId) }
      );
    }

    if (!result.ok) {
      state.step = "roll";

      userState.set(chatId, state);

      return bot.sendMessage(
        chatId,
        `❌ <b>Profile Could Not Be Created</b>
${escapeHtml(result.message)}

Please send a valid roll number.`,
        {
          parse_mode: "HTML",
          reply_markup: {
            inline_keyboard: [
              [{ text: "❌ Cancel", callback_data: "PROFILE_CANCEL", style: "danger" }],
            ],
          },
        }
      );
    }

    await clearResultProcess(chatId);

    const resetNote =
      state.reset && !isOwner(msg.from?.id)
        ? `\n\n🔁 Roll number changes remaining: <b>${studentProfile.rollChangesLeft(
            result.profile
          )} / ${studentProfile.MAX_ROLL_CHANGES}</b>`
        : "";

    const note =
      resetNote +
      (result.profile.namePending
        ? "\n\nℹ️ Your result is not yet available on the portal, so your name will be added automatically once it is published."
        : "");

    return bot.sendMessage(
      chatId,
      `✅ <b>Profile Ready</b>\n\n${studentProfile.formatProfile(
        result.profile
      )}${note}`,
      {
        parse_mode: "HTML",
        ...(isOwner(msg.from?.id) ? ownerMenu() : mainMenu(chatId)),
      }
    );
  } catch (error) {
    console.error("Profile setup error:", error);

    await deleteBotMessage(chatId, waiting.message_id);

    state.step = "roll";

    userState.set(chatId, state);

    return bot.sendMessage(
      chatId,
      "❌ <b>Temporary Issue</b>\nPlease send your roll number again, or try again in a few minutes.",
      { parse_mode: "HTML" }
    );
  }
}

async function showMyProfile(chatId, userId) {
  let profile = profiles.getByTelegramId(userId);

  if (!profile) {
    return startProfileSetup(chatId, { id: userId });
  }

  if (profile.namePending) {
    profile = await studentProfile.refreshPendingName(profile);
  }

  return bot.sendMessage(
    chatId,
    isOwner(userId)
      ? studentProfile.formatProfileForOwner(profile)
      : studentProfile.formatProfile(profile),
    {
      parse_mode: "HTML",
      ...profileButtons(chatId),
    }
  );
}

async function openMyLocker(chatId, userId, from) {
  const profile = profiles.getByTelegramId(userId);

  if (!profile) {
    return startProfileSetup(chatId, from || { id: userId });
  }

  const key = String(userId);

  if (lockerRunning.has(key)) {
    return bot.sendMessage(
      chatId,
      "⏳ <b>Your locker is already loading.</b>\nPlease wait a moment.",
      { parse_mode: "HTML" }
    );
  }

  if (isRateLimited(userId, 3, 60 * 1000, "locker")) {
    return bot.sendMessage(chatId, MSG.rateLimited, { parse_mode: "HTML" });
  }

  lockerRunning.add(key);

  const status = await bot.sendMessage(
    chatId,
    "🔐 <b>My Locker</b>\n\n⏳ Retrieving your available results...",
    { parse_mode: "HTML" }
  );

  try {
    const { sent, total } = await studentProfile.sendLocker(
      bot,
      chatId,
      profile,
      { channelId: CHANNEL_ID }
    );

    await deleteBotMessage(chatId, status.message_id);

    return bot.sendMessage(
      chatId,
      sent
        ? `✅ <b>Locker Ready</b>\n📄 ${sent} of ${total} result(s) have been sent to you.`
        : "📭 <b>No Results Available Yet</b>\nYour results will appear here as soon as they are published.",
      {
        parse_mode: "HTML",
        ...(isOwner(userId) ? ownerMenu() : mainMenu(chatId)),
      }
    );
  } catch (error) {
    console.error("Locker error:", error);

    await deleteBotMessage(chatId, status.message_id);

    return bot.sendMessage(
      chatId,
      "❌ <b>Locker Unavailable</b>\nYour locker could not be loaded. Please try again in a few minutes.",
      { parse_mode: "HTML" }
    );
  } finally {
    lockerRunning.delete(key);
  }
}

/* ---------------- OWNER: profile management ---------------- */

function findProfileByArg(arg) {
  return profiles.getByRoll(arg) || profiles.getByTelegramId(arg);
}

const PROFILE_EDIT_FIELDS = {
  name: "name",
  regno: "regNo",
  college: "collegeName",
  collegecode: "collegeCode",
  session: "sessionLabel",
  subject: "subject",
  roll: "roll",
};

function ownerOnly(msg) {
  if (isOwnerMessage(msg)) {
    return true;
  }

  bot.sendMessage(msg.chat.id, MSG.ownerOnly, { parse_mode: "HTML" });

  return false;
}

bot.onText(/^\/viewprofile(?:@\w+)?\s+(\d+)$/i, async (msg, match) => {
  if (!ownerOnly(msg)) return;

  const profile = findProfileByArg(match[1]);

  return bot.sendMessage(
    msg.chat.id,
    profile
      ? studentProfile.formatProfileForOwner(profile)
      : "❌ Profile not found.",
    { parse_mode: "HTML" }
  );
});

bot.onText(
  /^\/editprofile(?:@\w+)?\s+(\d+)\s+(\w+)\s+([\s\S]+)$/i,
  async (msg, match) => {
    if (!ownerOnly(msg)) return;

    const chatId = msg.chat.id;

    const profile = findProfileByArg(match[1]);

    const field = PROFILE_EDIT_FIELDS[String(match[2]).toLowerCase()];

    const value = String(match[3]).trim();

    if (!profile) {
      return bot.sendMessage(chatId, "❌ Profile not found.");
    }

    if (!field) {
      return bot.sendMessage(
        chatId,
        `❌ Invalid field. Allowed fields: ${Object.keys(PROFILE_EDIT_FIELDS).join(", ")}`
      );
    }

    if (field === "roll") {
      const other = profiles.getByRoll(value);

      if (
        !/^\d{13}$/.test(value) ||
        (other && String(other.telegramId) !== String(profile.telegramId))
      ) {
        return bot.sendMessage(
          chatId,
          "❌ The roll number must be 13 digits and must not be linked to another profile."
        );
      }
    }

    profile[field] = value;

    if (field === "sessionLabel") {
      profile.sessionManual = true;
    }

    if (field === "name") {
      profile.namePending = false;
    }

    await profiles.save(profile);

    return bot.sendMessage(
      chatId,
      `✅ Updated.\n\n${studentProfile.formatProfileForOwner(profile)}`,
      { parse_mode: "HTML" }
    );
  }
);

bot.onText(/^\/deleteprofile(?:@\w+)?\s+(\d+)$/i, async (msg, match) => {
  if (!ownerOnly(msg)) return;

  const profile = findProfileByArg(match[1]);

  if (!profile) {
    return bot.sendMessage(msg.chat.id, "❌ Profile not found.");
  }

  await profiles.remove(profile.telegramId);

  return bot.sendMessage(
    msg.chat.id,
    `🗑️ Profile deleted: ${profile.roll} (${profile.name || "no name"})`
  );
});

bot.onText(/^\/pdftext(?:@\w+)?\s+(\d+)$/i, async (msg, match) => {
  if (!ownerOnly(msg)) return;

  const profile = findProfileByArg(match[1]);

  if (!profile) {
    return bot.sendMessage(msg.chat.id, "❌ Profile not found.");
  }

  try {
    const report = await studentProfile.debugProfilePdf(profile);

    return bot.sendMessage(msg.chat.id, report.slice(0, 3900));
  } catch (error) {
    return bot.sendMessage(msg.chat.id, `❌ ${error.message}`);
  }
});

bot.onText(/^\/lockertrace(?:@\w+)?\s+(\d+)$/i, async (msg, match) => {
  if (!ownerOnly(msg)) return;

  const profile = findProfileByArg(match[1]);

  if (!profile) {
    return bot.sendMessage(msg.chat.id, "❌ Profile not found.");
  }

  try {
    const report = await studentProfile.traceLocker(profile);

    return bot.sendMessage(msg.chat.id, report.slice(0, 3900));
  } catch (error) {
    return bot.sendMessage(msg.chat.id, `❌ ${error.message}`);
  }
});

bot.onText(/^\/fullscan(?:@\w+)?\s+(\d{13})$/i, async (msg, match) => {
  if (!ownerOnly(msg)) return;

  const waiting = await bot.sendMessage(
    msg.chat.id,
    "🔎 Full scan in progress (all sessions, exam types and courses). This may take some time."
  );

  try {
    const chunks = await studentProfile.fullScanReportChunks(match[1]);

    for (const chunk of chunks) {
      await bot.sendMessage(msg.chat.id, chunk, {
        parse_mode: "HTML",
        disable_web_page_preview: true,
      });
    }
  } catch (error) {
    await bot.sendMessage(msg.chat.id, `❌ ${error.message}`);
  } finally {
    bot.deleteMessage(msg.chat.id, waiting.message_id).catch(() => {});
  }
});

bot.onText(/^\/profiles(?:@\w+)?$/i, async (msg) => {
  if (!ownerOnly(msg)) return;

  const all = profiles.list();

  const lines = all
    .slice(0, 40)
    .map((p, i) => `${i + 1}. ${p.roll} — ${p.name || "(name pending)"}`);

  return bot.sendMessage(
    msg.chat.id,
    `👥 Total profiles: ${all.length}\n\n${lines.join("\n") || "—"}`
  );
});

async function restrictedNotFound(chatId, checkingMessage, roll, reasonText) {
  if (checkingMessage) {
    await deleteBotMessage(chatId, checkingMessage.message_id);
  }

  await clearResultProcess(chatId);

  return bot.sendMessage(
    chatId,
    `❌ <b>Result Not Available</b>

Roll Number: <code>${escapeHtml(roll)}</code>
${reasonText}`,
    {
      parse_mode: "HTML",
      reply_markup: {
        inline_keyboard: colorRows([
          {
            text: "🔄 Try Another Selection",
            callback_data: "CHECK_ANOTHER",
          },
          { text: "🏠 Main Menu", callback_data: "MAIN_MENU" },
        ]),
      },
    }
  );
}

async function runRollCheck(chatId, state, roll, fromId) {
  const restricted = OWN_ROLL_ONLY && !isOwner(fromId);

  state.roll = roll;
  state.step = "checking";

  userState.set(chatId, state);

  let checkingMessage = null;

  try {
    checkingMessage = await sendCheckingMessage(chatId, state, roll);

    const result = await checkResult({
      session: state.session,
      examType: state.examType,
      course: state.course,
      roll,
    });

    if (!result.success && restricted) {
      return restrictedNotFound(
        chatId,
        checkingMessage,
        roll,
        "No result was found for this session, exam type and course. Please try a different selection."
      );
    }

    if (!result.success) {
      state.rollAttempts = Number(state.rollAttempts || 0) + 1;

      if (state.rollAttempts < 2) {
        state.roll = null;
        state.step = "roll";

        userState.set(chatId, state);

        if (checkingMessage) {
          await deleteBotMessage(chatId, checkingMessage.message_id);
        }

        state.messageId = null;

        userState.set(chatId, state);

        return showRollNumber(
          chatId,
          `⚠️ <b>Result Not Found</b>
No result was found for:
<code>${escapeHtml(roll)}</code>
Please verify the roll number and try again.
<b>1 attempt remaining.</b>`
        );
      }

      if (checkingMessage) {
        await deleteBotMessage(chatId, checkingMessage.message_id);
      }

      await clearResultProcess(chatId);

      return bot.sendMessage(
        chatId,
        `❌ <b>Result Not Found</b>
No result was found for:
<code>${escapeHtml(roll)}</code>
Two attempts were made without success.
Please start a new result check.`,
        {
          parse_mode: "HTML",
          ...(isOwner(fromId) ? ownerMenu() : mainMenu(chatId)),
        }
      );
    }

    if (result.type === "pdf" && result.pdfUrl) {
      if (checkingMessage) {
        await deleteBotMessage(chatId, checkingMessage.message_id);
      }

      state.messageId = null;

      userState.set(chatId, state);

      console.log("📄 Sending PDF");

      const pdfResponse = await fetch(result.pdfUrl, {
        signal: AbortSignal.timeout(20000),
      });

      if (!pdfResponse.ok) {
        throw new Error(
          `Unable to download result PDF. HTTP ${pdfResponse.status}`
        );
      }

      const pdfBuffer = Buffer.from(await pdfResponse.arrayBuffer());

      const filename = `${String(result.roll || roll).trim()}.pdf`;

      console.log("📤 Uploading PDF to Telegram:", filename);

      const tempResultPdf = path.join(
        os.tmpdir(),
        `ppu-result-${Date.now()}-${String(roll).replace(/\D/g, "")}.pdf`
      );

      await fs.promises.writeFile(tempResultPdf, pdfBuffer);

      console.log("🔎 Extracting student details from result PDF...");

      const resultDetails = await extractResultDetails(tempResultPdf);

      try {
        const saved = await saveResult(resultDetails, {
          roll: resultDetails.roll || roll,
          session: state.session,
          examType: state.examType,
          course: state.course,
          pdfUrl: result.pdfUrl,
          source: "start",
        });

        if (saved && !saved.skipped) {
          console.log(
            `💾 Supabase saved: ${maskRoll(resultDetails.roll || roll)}`
          );
        }
      } catch (error) {
        console.error("⚠️ Supabase save failed:", error.message);
      }

      console.log("🧾 Roll Number:", maskRoll(resultDetails.roll || roll));
      console.log("📊 SGPA:", resultDetails.sgpa || "Not Found");
      console.log("📝 Remarks:", resultDetails.remarks || "Not Found");

      const caption = buildResultCaption(resultDetails, state, roll);

      console.log("📤 Uploading PDF with result caption...");

      const deliveredMessage = await bot.sendDocument(
        chatId,
        pdfBuffer,
        {
          parse_mode: "HTML",
          caption,
        },
        {
          filename,
          contentType: "application/pdf",
        }
      );

      console.log("✅ PDF + result caption sent successfully:", filename);

      /*
        Copy the same delivered message to the channel.
        Runs in the background: the user's flow and messages
        stay exactly the same even if the channel copy fails.
      */
      if (CHANNEL_ID && deliveredMessage?.message_id) {
        bot
          .copyMessage(CHANNEL_ID, chatId, deliveredMessage.message_id)
          .then(() => console.log("📢 Single result copied to channel"))
          .catch((channelError) =>
            console.error(
              "⚠️ Channel copy failed (single result):",
              channelError.message
            )
          );
      }

      try {
        await fs.promises.unlink(tempResultPdf);
      } catch (_) {}

      console.log("✅ PDF sent successfully:", filename);

      await clearResultProcess(chatId);

      return bot.sendMessage(
        chatId,
        `✅ <b>Result Delivered</b>
Please choose what you would like to do next.`,
        {
          parse_mode: "HTML",

          reply_markup: {
            inline_keyboard: colorRows([
              {
                text: "🔄 Check Another Result",
                callback_data: "CHECK_ANOTHER",
              },
              {
                text: "🏠 Main Menu",
                callback_data: "MAIN_MENU",
              },
            ]),
          },
        }
      );
    }

    if (result.type === "html" && restricted) {
      return restrictedNotFound(
        chatId,
        checkingMessage,
        roll,
        "The portal did not provide a result PDF this time. Please try again in a few minutes."
      );
    }

    if (result.type === "html") {
      state.rollAttempts = Number(state.rollAttempts || 0) + 1;

      if (state.rollAttempts < 2) {
        state.roll = null;
        state.step = "roll";

        userState.set(chatId, state);

        if (checkingMessage) {
          await deleteBotMessage(chatId, checkingMessage.message_id);
        }

        state.messageId = null;

        userState.set(chatId, state);

        return showRollNumber(
          chatId,
          `⚠️ <b>Result PDF Unavailable</b>
The result page was found, but the portal did not provide a PDF.
Please verify the roll number and try again.
<b>1 attempt remaining.</b>`
        );
      }

      if (checkingMessage) {
        await deleteBotMessage(chatId, checkingMessage.message_id);
      }

      await clearResultProcess(chatId);

      return bot.sendMessage(
        chatId,
        `❌ <b>Result Could Not Be Retrieved</b>
The portal did not provide a downloadable result after two attempts.
Please start a new result check.`,
        {
          parse_mode: "HTML",
          ...mainMenu(chatId),
        }
      );
    }

    if (checkingMessage) {
      await deleteBotMessage(chatId, checkingMessage.message_id);
    }

    await clearResultProcess(chatId);

    return bot.sendMessage(
      chatId,
      `❌ <b>Result Unavailable</b>
The result could not be retrieved. Please start a new result check.`,
      {
        parse_mode: "HTML",
        ...mainMenu(chatId),
      }
    );
  } catch (error) {
    console.error("Result checking error:", error);

    if (checkingMessage) {
      await deleteBotMessage(chatId, checkingMessage.message_id);
    }

    if (restricted) {
      return restrictedNotFound(
        chatId,
        null,
        roll,
        "The result portal is not responding at the moment. Please try again in a few minutes."
      );
    }

    const currentState = userState.get(chatId);

    if (currentState) {
      currentState.roll = null;
      currentState.step = "roll";
      currentState.messageId = null;

      userState.set(chatId, currentState);

      return showRollNumber(
        chatId,
        `⚠️ <b>Temporary Issue</b>
The result portal could not be reached.
Your selected session, exam type and course have been kept. Please send the roll number again.
Send /start to begin a new result check.`
      );
    }

    return bot.sendMessage(
      chatId,
      `❌ <b>Temporary Issue</b>
The result could not be checked right now. Please try again shortly.`,
      {
        parse_mode: "HTML",
        ...mainMenu(chatId),
      }
    );
  }
}

bot.on("polling_error", (error) => {
  console.error("Telegram polling error:", error.message);
});

process.on("unhandledRejection", (error) => {
  console.error("Unhandled rejection:", error);
});

let shuttingDown = false;

async function shutdown(signal, exitCode = 0) {
  if (shuttingDown) return;
  shuttingDown = true;

  console.log(`🛑 ${signal} received - shutting down...`);
  setTimeout(() => process.exit(exitCode || 1), 10000).unref();

  try {
    await bot.stopPolling();
  } catch (_) {}
  try {
    await closeAll();
  } catch (_) {}

  process.exit(exitCode);
}

process.on("SIGINT", () => shutdown("SIGINT"));
process.on("SIGTERM", () => shutdown("SIGTERM"));

// State may be corrupt after an uncaught exception: exit and let
// PM2 / Docker start a clean process.
process.on("uncaughtException", (error) => {
  console.error("Uncaught exception:", error);
  shutdown("uncaughtException", 1);
});