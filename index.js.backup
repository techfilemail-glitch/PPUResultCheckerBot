function isOwner(userId) {
  const id = String(userId ?? "").trim();

  if (!id) {
    return false;
  }

  return OWNER_IDS.has(id);
}

function isOwnerMessage(msg) {
  return !!(msg && msg.from && isOwner(msg.from.id));
}

function isOwnerCallback(query) {
  return !!(query && query.from && isOwner(query.from.id));
}
function isSubjectBulkAllowed(userId) {
  const id = String(userId ?? "").trim();

  if (!id) {
    return false;
  }

  // Owner ko Subject Bulk hamesha available rahega.
  if (isOwner(id)) {
    return true;
  }

  // Normal user: profile setup required.
  return Boolean(profiles.getByTelegramId(id));
}

function isCollegeBulkAllowed(userId) {
  const id = String(userId ?? "").trim();

  if (!id) {
    return false;
  }

  // Owner ko College Bulk hamesha available rahega.
  if (isOwner(id)) {
    return true;
  }

  // Normal user: profile + College Bulk FREE required.
  return (
    COLLEGE_BULK_OPEN &&
    Boolean(profiles.getByTelegramId(id))
  );
}

function isBulkAllowed(userId) {
  return (
    isSubjectBulkAllowed(userId) ||
    isCollegeBulkAllowed(userId)
  );
}

function isBulkMessageAllowed(msg, state = null) {
  const currentUserId = String(msg?.from?.id ?? "").trim();
  const stateOwnerId = String(state?.ownerId ?? "").trim();

  if (!currentUserId) {
    return false;
  }

  // Bulk session jis Telegram account ne start kiya,
  // wahi account us session ko continue kare.
  if (stateOwnerId && stateOwnerId !== currentUserId) {
    return false;
  }

  // Owner
  if (isOwner(currentUserId)) {
    return true;
  }

  // Normal user ko profile required hai.
  if (!profiles.getByTelegramId(currentUserId)) {
    return false;
  }

  // Existing state ke bulkType ke according permission.
  if (state?.bulkType === "subject") {
    return isSubjectBulkAllowed(currentUserId);
  }

  if (state?.bulkType === "college") {
    return isCollegeBulkAllowed(currentUserId);
  }

  return false;
}

  // Owner
  if (isOwner(currentUserId)) {
    return !stateOwnerId || stateOwnerId === currentUserId;
  }

  // Normal user: profile required
  if (!profiles.getByTelegramId(currentUserId)) {
    return false;
  }

  // Bulk state kisi doosre Telegram account ko use nahi karne dena.
  return !stateOwnerId || stateOwnerId === currentUserId;
}

function escapeHtml(value) {
  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function encodeValue(value) {
  return Buffer.from(String(value), "utf8").toString("base64url");
}

function decodeValue(value) {
  return Buffer.from(String(value), "base64url").toString("utf8");
}

function safeFileName(value) {
  return (
    String(value || "")
      .replace(/[<>:"/\\|?*\x00-\x1F]/g, "_")
      .replace(/\s+/g, "_")
      .replace(/_+/g, "_")
      .replace(/^_+|_+$/g, "")
      .slice(0, 120) || "file"
  );
}

/* =========================================================
   BUTTON LAYOUT + COLOURS
   Telegram "style": primary (blue) | success (green) | danger (red)
   Older Telegram clients simply show normal buttons.
========================================================= */

const BUTTON_COLORS = ["primary", "success", "danger"];

// Splits flat buttons into rows of two; both buttons in a row share one colour.
function colorRows(buttons, perRow = 2, startColor = 0) {
  const rows = [];

  for (let i = 0; i < buttons.length; i += perRow) {
    const style =
      BUTTON_COLORS[(startColor + i / perRow) % BUTTON_COLORS.length];

    rows.push(buttons.slice(i, i + perRow).map((b) => ({ ...b, style })));
  }

  return rows;
}

function navRow(backCallback) {
  return [
    { text: "⬅️ Back", callback_data: backCallback, style: "primary" },
    { text: "❌ Cancel", callback_data: "CANCEL_RESULT", style: "danger" },
  ];
}

/* Course categories (shown as a 2 x 2 grid) */
const COURSE_TYPES = [
  { code: "UGT", label: "UG (Regular)" },
  { code: "UGV", label: "UG (Vocational)" },
  { code: "PGT", label: "PG (Regular)" },
  { code: "PGV", label: "PG (Vocational)" },
];

function courseTypeLabel(code) {
  const found = COURSE_TYPES.find((c) => c.code === code);
  return found ? `${found.code} — ${found.label}` : null;
}

// Best-effort classification of a course name into UGT / UGV / PGT / PGV.
function classifyCourse(text) {
  const t = String(text || "").toLowerCase();

  const vocational = /vocational|\bvoc\b/.test(t);

  const postGraduate =
    /\b(m\.?\s?a|m\.?\s?sc|m\.?\s?com|m\.?\s?ed|m\.?\s?lib|m\.?\s?b\.?\s?a|m\.?\s?c\.?\s?a|master|post[\s-]?graduate|pg)\b/.test(
      t
    );

  return `${postGraduate ? "PG" : "UG"}${vocational ? "V" : "T"}`;
}

