}

async function mergePdfFiles(inputPaths, outputPath) {
  const mergedPdf = await PDFDocument.create();

  if (!Array.isArray(inputPaths) || !inputPaths.length) {
    throw new Error("No PDF files available for merging.");
  }

  const MERGE_BATCH_SIZE = 4;

  for (let start = 0; start < inputPaths.length; start += MERGE_BATCH_SIZE) {
    const batch = inputPaths.slice(start, start + MERGE_BATCH_SIZE);

    const loaded = await Promise.all(
      batch.map(async (filePath) => {
        try {
          const bytes = await fs.promises.readFile(filePath);

          const sourcePdf = await PDFDocument.load(bytes, {
            ignoreEncryption: true,
          });

          return { filePath, sourcePdf };
        } catch (error) {
          console.error(
            "⚠️ PDF merge load skip:",
            path.basename(filePath),
            error.message
          );

          return null;
        }
      })
    );

    for (const item of loaded) {
      if (!item) continue;

      try {
        const pages = await mergedPdf.copyPages(
          item.sourcePdf,
          item.sourcePdf.getPageIndices()
        );

        for (const page of pages) {
          mergedPdf.addPage(page);
        }
      } catch (error) {
        console.error(
          "⚠️ PDF merge copy skip:",
          path.basename(item.filePath),
          error.message
        );
      }
    }
  }

  if (mergedPdf.getPageCount() === 0) {
    throw new Error("No valid PDF pages available for merging.");
  }

  const mergedBytes = await mergedPdf.save();

  await fs.promises.writeFile(outputPath, mergedBytes);

  return outputPath;
}

async function processMergedPdfToSupabase(subjectPdfPath, job) {
  const fileName = path.basename(subjectPdfPath);

  try {
    console.log(`☁️ [SB] Parsing merged PDF → ${fileName}`);

    const results = await extractResultsFromMergedPdf(subjectPdfPath);

    if (!Array.isArray(results) || !results.length) {
      console.log(`↩️ [SB] No valid results found → ${fileName}`);

      return {
        parsed: 0,
        saved: 0,
        skipped: 0,
        failed: 0,
      };
    }

    console.log(`📄 [SB] Parsed ${results.length} students → ${fileName}`);

    const meta = {
      session: job.session || job.sessionName || null,
      examType: job.examType || null,
      course: job.course || job.courseName || null,
      majorPaper: job.subject || job.subjectName || null,
      source: "bulk-college",
      pdfUrl: null,
    };

    const savedRows = await saveResults(results, meta);

    /*
     * Supabase disabled
     */
    if (savedRows && !Array.isArray(savedRows) && savedRows.skipped) {
      console.log(`↩️ [SB] Skipped → ${fileName}: ${savedRows.reason}`);

      return {
        parsed: results.length,
        saved: 0,
        skipped: results.length,
        failed: 0,
      };
    }

    const savedCount = Array.isArray(savedRows)
      ? savedRows.length
      : results.length;

    console.log(`✅ [SB] Saved ${savedCount}/${results.length} → ${fileName}`);

    return {
      parsed: results.length,
      saved: savedCount,
      skipped: Math.max(0, results.length - savedCount),
      failed: 0,
    };
  } catch (error) {
    console.error(`❌ [SB] Failed → ${fileName}:`, error.message);

    return {
      parsed: 0,
      saved: 0,
      skipped: 0,
      failed: 1,
      error: error.message,
    };
  }
}

async function processCollegeSubject(
  chatId,
  job,
  subjectIndex,
  totalSubjects,
  runDir,
  status,
  telegramQueue,
  supabaseQueue
) {
  const startedAt = Date.now();

  const from = COLLEGE_ROLL_FROM;
  const to = COLLEGE_ROLL_TO;
  const totalRolls = to - from + 1;

  const safeSubject = safeFileName(job.subject || "Subject");

  const subjectDir = path.join(runDir, `${subjectIndex + 1}-${safeSubject}`);

  await fs.promises.mkdir(subjectDir, { recursive: true });

  const tasks = [];

  for (let roll = from; roll <= to; roll++) {
    let fullRoll;

    try {
      fullRoll = bulkCollege.createRollNumber(
        job.registrationYear,
        job.collegeCode,
        job.subjectCode,
        roll
      );
    } catch (error) {
      console.error(" Roll creation error:", error.message);

      fullRoll = String(job.prefix || "") + String(roll).padStart(4, "0");
    }

    tasks.push({ roll, fullRoll });
  }

  console.log("");
  console.log("======================================");
  console.log(` SUBJECT ${subjectIndex + 1}/${totalSubjects}`);
  console.log("======================================");
  console.log(" Subject:", job.subject);
  console.log(" Subject Code:", job.subjectCode);
  console.log(" College:", job.collegeName);
  console.log(" College Code:", job.collegeCode);
  console.log(
    " Roll Range:",
    `${String(from).padStart(4, "0")} - ${String(to).padStart(4, "0")}`
  );
  console.log(" Total Rolls:", totalRolls);
  console.log(" Search Concurrency:", COLLEGE_CONCURRENCY);
  console.log("======================================");

  if (status?.message_id) {
    try {
      await bot.editMessageText(
        `🔎 <b>Searching Subject ${subjectIndex + 1} of ${totalSubjects}</b>\n\n` +
          `🏫 College: <b>${escapeHtml(job.collegeName)}</b>\n` +
          `📚 Subject: <b>${escapeHtml(job.subject)}</b>\n\n` +
          `⏳ Searching ${totalRolls} roll numbers...`,
        {
          chat_id: chatId,
          message_id: status.message_id,
          parse_mode: "HTML",
        }
      );
    } catch (_) {}
  }

  let checked = 0;
  let found = 0;
  let notFound = 0;
  let errors = 0;

  const cachedPdfPaths = [];

  let nextIndex = 0;
  let statusUpdating = false;

  async function updateLiveStatus(force = false) {
    if (statusUpdating) {
      return;
    }

    if (!force && checked % 10 !== 0) {
      return;
    }

    if (!status?.message_id) {
      return;
    }

    statusUpdating = true;

    try {
      await bot.editMessageText(
        `📡 <b>Bulk Search in Progress</b>\n\n` +
          `📚 Subject: <b>${escapeHtml(job.subject)}</b>\n` +
          `🏫 College: <b>${escapeHtml(job.collegeName)}</b>\n` +
          `📈 Progress: <b>${checked}/${totalRolls}</b>\n` +
          `📄 Results Found: <b>${found}</b>\n\n` +
          `⏳ Please wait...`,
        {
          chat_id: chatId,
          message_id: status.message_id,
          parse_mode: "HTML",
        }
      );
    } catch (_) {
    } finally {
      statusUpdating = false;
    }
  }

  async function worker(workerId) {
    while (true) {
      const index = nextIndex++;

      if (index >= tasks.length) {
        return;
      }

      const task = tasks[index];

      try {
        console.log(
          ` [W${workerId}] ${index + 1}/${totalRolls} → ${task.fullRoll} | ${
            job.subject
          }`
        );

        const result = await checkResult({
          session: job.session,
          examType: job.examType,
          course: job.course,
          roll: task.fullRoll,
        });

        if (
          result &&
          result.success &&
          result.type === "pdf" &&
          result.pdfUrl
        ) {
          try {
            const response = await fetch(result.pdfUrl, {
              signal: AbortSignal.timeout(20000),
            });

            if (!response.ok) {
              throw new Error(`HTTP ${response.status}`);
            }

            const pdfBuffer = Buffer.from(await response.arrayBuffer());

            const pdfPath = path.join(subjectDir, `${task.fullRoll}.pdf`);

            await fs.promises.writeFile(pdfPath, pdfBuffer);

            cachedPdfPaths.push(pdfPath);

            found++;

            console.log(` [W${workerId}] CACHED → ${task.fullRoll}.pdf`);
          } catch (downloadError) {
            errors++;

            console.error(
              ` [W${workerId}] DOWNLOAD ERROR → ${task.fullRoll}:`,
              downloadError.message
            );
          }
        } else {
          notFound++;

          console.log(` [W${workerId}] NOT FOUND → ${task.fullRoll}`);
        }
      } catch (error) {
        errors++;

        console.error(
          ` [W${workerId}] SEARCH ERROR → ${task.fullRoll}:`,
          error.message
        );
      }

      checked++;

      if (checked % 10 === 0 || checked === totalRolls) {
        await updateLiveStatus(checked === totalRolls);
      }
    }
  }

  const workerCount = Math.min(COLLEGE_CONCURRENCY, tasks.length);

  await Promise.all(
    Array.from({ length: workerCount }, (_, i) => worker(i + 1))
  );

  await updateLiveStatus(true);

  cachedPdfPaths.sort((a, b) => {
    const rollA = Number(path.basename(a, ".pdf").replace(/\D/g, ""));
    const rollB = Number(path.basename(b, ".pdf").replace(/\D/g, ""));

    return rollA - rollB;
  });

  const elapsed = Math.max(1, Math.round((Date.now() - startedAt) / 1000));

  console.log(` Subject search finished → ${job.subject}`);
  console.log(" Cached PDFs:", cachedPdfPaths.length);

  if (!cachedPdfPaths.length) {
    if (status?.message_id) {
      try {
        await bot.editMessageText(
          `✅ <b>Subject Completed</b>\n\n` +
            `📚 Subject: <b>${escapeHtml(job.subject)}</b>\n` +
            `🔢 Roll Numbers Checked: <b>${checked}</b>\n` +
            `📄 Result PDFs: <b>0</b>\n\n` +
            `No result PDFs were found for this subject.\n\n` +
            `Moving on to the next subject...`,
          {
            chat_id: chatId,
            message_id: status.message_id,
            parse_mode: "HTML",
          }
        );
      } catch (_) {}
    }

    return {
      job,
      subjectIndex,
      totalRolls,
      checked,
      found: 0,
      notFound,
      errors,
      subjectPdfPath: null,
      elapsed,
      telegramPromise: Promise.resolve({ sent: false }),
      supabasePromise: Promise.resolve({
        parsed: 0,
        saved: 0,
        failed: 0,
        skipped: 0,
      }),
    };
  }

  console.log(" Merging subject PDFs...");

  const subjectPdfName = `${safeFileName(job.collegeName)}_${safeFileName(
    job.collegeCode
  )}_${safeSubject}_${safeFileName(job.session)}_${safeFileName(
    job.course
  )}_merged.pdf`;

  const subjectPdfPath = path.join(runDir, subjectPdfName);

  await mergePdfFiles(cachedPdfPaths, subjectPdfPath);

  console.log(" Subject merged:", subjectPdfName);

  const telegramPromise = telegramQueue.add(async () => {
    const destination = BOT_CHAT_ID || String(chatId);

    try {
      console.log(` [TG] Sending → ${subjectPdfName}`);

      // size check + auto split (>45MB) + timeout + retry + fallback destination
      return await tgSender.sendMergedPdf({
        destination,
        fallbackDestination: String(chatId),
        channelId: CHANNEL_ID,
        filePath: subjectPdfPath,
        fileName: subjectPdfName,
      });
    } catch (error) {
      console.error(` [TG] Send failed → ${subjectPdfName}:`, error.message);

      return {
        sent: false,
        channelSent: false,
        error: error.message,
      };
    }
  });

  const supabasePromise = supabaseQueue.add(async () => {
    return processMergedPdfToSupabase(subjectPdfPath, job);
  });

  if (status?.message_id) {
    try {
      await bot.editMessageText(
        `📎 <b>Subject Merged</b>\n\n` +
          `📚 Subject: <b>${escapeHtml(job.subject)}</b>\n` +
          `🔢 Roll Numbers Checked: <b>${checked}</b>\n` +
          `📄 Result PDFs: <b>${cachedPdfPaths.length}</b>\n\n` +
          `📤 Telegram: <b>Queued</b>\n` +
          `☁️ Database: <b>Queued</b>\n\n` +
          `Starting the next subject...`,
        {
          chat_id: chatId,
          message_id: status.message_id,
          parse_mode: "HTML",
        }
      );
    } catch (_) {}
  }

  return {
    job,
    subjectIndex,
    totalRolls,
    checked,
    found,
    notFound,
    errors,
    subjectPdfPath,
    subjectPdfName,
    elapsed,
    telegramPromise,
    supabasePromise,
  };
}

async function runCollegeBulkSearch(chatId, jobs) {
  const startedAt = Date.now();

  let totalRolls = 0;
  let totalFound = 0;
  let totalNotFound = 0;
  let totalErrors = 0;

  let totalSupabaseParsed = 0;
  let totalSupabaseSaved = 0;
  let totalSupabaseFailed = 0;
  let totalSupabaseSkipped = 0;

  let totalTelegramSent = 0;
  let totalChannelSent = 0;
  let totalTelegramFailed = 0;

  const subjectResults = [];

  let runDir = null;
  let statusMessage = null;

  const telegramQueue = createAsyncQueue(BULK_TELEGRAM_CONCURRENCY);
  const supabaseQueue = createAsyncQueue(BULK_SUPABASE_CONCURRENCY);

  try {
    if (!Array.isArray(jobs) || !jobs.length) {
      throw new Error("No valid college bulk jobs found.");
    }

    runDir = await fs.promises.mkdtemp(
      path.join(os.tmpdir(), "ppu-college-bulk-")
    );

    try {
      const rollsPerSubject = COLLEGE_ROLL_TO - COLLEGE_ROLL_FROM + 1;

      statusMessage = await bot.sendMessage(
        chatId,
        `🏫 <b>College Bulk Search Started</b>\n\n` +
          `🏫 College: <b>${escapeHtml(jobs[0].collegeName)}</b>\n` +
          `🔖 College Code: <b>${escapeHtml(jobs[0].collegeCode)}</b>\n` +
          `📚 Subjects: <b>${jobs.length}</b>\n` +
          `🔢 Roll Numbers per Subject: <b>${rollsPerSubject}</b>\n` +
          `🧮 Total Roll Numbers: <b>${jobs.length * rollsPerSubject}</b>\n\n` +
          `⚡ Search: <b>${COLLEGE_CONCURRENCY}</b> concurrent\n` +
          `📤 Telegram: <b>${BULK_TELEGRAM_CONCURRENCY}</b> concurrent\n` +
          `☁️ Database: <b>${BULK_SUPABASE_CONCURRENCY}</b> concurrent\n\n` +
          `⏳ Starting...`,
        { parse_mode: "HTML" }
      );
    } catch (error) {
      console.error("Status message error:", error.message);
    }

    const subjectConcurrency = Math.max(
      1,
      Number(process.env.BULK_SUBJECT_CONCURRENCY || 1)
    );

    let nextSubjectIndex = 0;

    async function subjectWorker(workerId) {
      while (true) {
        const subjectIndex = nextSubjectIndex++;

        if (subjectIndex >= jobs.length) {
          return;
        }

        const job = jobs[subjectIndex];

        try {
          console.log(
            `🚀 [S${workerId}] Starting subject ${subjectIndex + 1}/${
              jobs.length
            } → ${job.subject}`
          );

          const result = await processCollegeSubject(
            chatId,
            job,
            subjectIndex,
            jobs.length,
            runDir,
            statusMessage,
            telegramQueue,
            supabaseQueue
          );

          subjectResults[subjectIndex] = result;

          totalRolls += result.totalRolls || 0;
          totalFound += result.found || 0;
          totalNotFound += result.notFound || 0;
          totalErrors += result.errors || 0;

          console.log(
            ` [S${workerId}] Subject ${
              subjectIndex + 1
            } merged/queued → next subject can start`
          );
        } catch (error) {
          console.error(
            ` [S${workerId}] Subject failed → ${job.subject}:`,
            error.message
          );

          const failedResult = {
            job,
            subjectIndex,
            totalRolls: COLLEGE_ROLL_TO - COLLEGE_ROLL_FROM + 1,
            checked: 0,
            found: 0,
            notFound: 0,
            errors: 1,
            subjectPdfPath: null,
            elapsed: Math.max(1, Math.round((Date.now() - startedAt) / 1000)),
            telegramPromise: Promise.resolve({ sent: false }),
            supabasePromise: Promise.resolve({
              parsed: 0,
              saved: 0,
              failed: 1,
              skipped: 0,
            }),
          };

          subjectResults[subjectIndex] = failedResult;

          totalRolls += failedResult.totalRolls;
          totalErrors += 1;
        }
      }
    }

    const workers = Array.from(
      { length: Math.min(subjectConcurrency, jobs.length) },
      (_, i) => subjectWorker(i + 1)
    );

    await Promise.all(workers);

    console.log("======================================");
    console.log("🔄 ALL SUBJECT SEARCH/MERGE STAGES FINISHED");
    console.log("☁️ Telegram + Supabase background jobs are now draining...");
    console.log("======================================");

    const telegramSettled = await telegramQueue.drain();
    const supabaseSettled = await supabaseQueue.drain();

    for (const result of subjectResults) {
      if (!result) {
        continue;
      }

      if (result.telegramPromise) {
        const settled = await Promise.allSettled([result.telegramPromise]);

        const value = settled[0]?.value;

        if (settled[0]?.status === "fulfilled") {
          if (value?.sent) {
            totalTelegramSent++;
          }

          if (value?.channelSent) {
            totalChannelSent++;
          }

          if (!value?.sent) {
            totalTelegramFailed++;
          }
        } else {
          totalTelegramFailed++;
        }
      }

      if (result.supabasePromise) {
        const settled = await Promise.allSettled([result.supabasePromise]);

        const value = settled[0]?.value;

        if (settled[0]?.status === "fulfilled") {
          totalSupabaseParsed += Number(value?.parsed || 0);
          totalSupabaseSaved += Number(value?.saved || 0);
          totalSupabaseFailed += Number(value?.failed || 0);
          totalSupabaseSkipped += Number(value?.skipped || 0);
        } else {
          totalSupabaseFailed++;
        }
      }
    }

    console.log(`📤 Telegram queue settled: ${telegramSettled.length}`);
    console.log(`☁️ Supabase queue settled: ${supabaseSettled.length}`);

    const elapsed = Date.now() - startedAt;

    const seconds = Math.max(1, Math.round(elapsed / 1000));

    const rate = (totalRolls / seconds).toFixed(2);

    console.log("======================================");
    console.log("🏁 COLLEGE BULK SEARCH FINISHED");
    console.log("======================================");
    console.log("📚 Subjects:", jobs.length);
    console.log("🔢 Total Rolls:", totalRolls);
    console.log("📄 Total PDFs:", totalFound);
    console.log("❌ Search/Download Errors:", totalErrors);
    console.log("☁️ Supabase Parsed:", totalSupabaseParsed);
    console.log("💾 Supabase Saved:", totalSupabaseSaved);
    console.log("↩️ Supabase Skipped:", totalSupabaseSkipped);
    console.log("❌ Supabase Failed:", totalSupabaseFailed);
    console.log("📤 Telegram Sent:", totalTelegramSent);
    console.log("📢 Channel Copied:", totalChannelSent);
    console.log("❌ Telegram Failed:", totalTelegramFailed);
    console.log("⏱️ Time:", seconds, "sec");
    console.log("⚡ Speed:", rate, "roll/sec");
    console.log("======================================");

    if (statusMessage) {
      try {
        await bot.editMessageText(
          `🎉 <b>College Bulk Search Completed</b>\n\n` +
            `🏫 College: <b>${escapeHtml(jobs[0].collegeName)}</b>\n` +
            `📚 Subjects: <b>${jobs.length}</b>\n` +
            `🔢 Roll Numbers Checked: <b>${totalRolls}</b>\n` +
            `📄 Result PDFs: <b>${totalFound}</b>\n\n` +
            `☁️ Records Parsed: <b>${totalSupabaseParsed}</b>\n` +
            `💾 Records Saved: <b>${totalSupabaseSaved}</b>\n` +
            `📤 Files Sent: <b>${totalTelegramSent}</b>\n` +
            `📢 Channel Copies: <b>${totalChannelSent}</b>\n\n` +
            `⏱️ Time Taken: <b>${seconds}s</b>\n` +
            `🚀 Speed: <b>${rate} rolls/sec</b>`,
          {
            chat_id: chatId,
            message_id: statusMessage.message_id,
            parse_mode: "HTML",
          }
        );
      } catch (_) {}
    }

    return {
      totalSubjects: jobs.length,
      totalRolls,
      totalFound,
      totalNotFound,
      totalErrors,
      supabaseExtractedCount: totalSupabaseParsed,
      supabaseSavedCount: totalSupabaseSaved,
      supabaseFailedCount: totalSupabaseFailed,
      telegramSentCount: totalTelegramSent,
      channelCopiedCount: totalChannelSent,
      telegramFailedCount: totalTelegramFailed,
      seconds,
      rate,
    };
  } finally {
    if (runDir) {
      try {
        await fs.promises.rm(runDir, {
          recursive: true,
          force: true,
        });

        console.log("🧹 Temporary cache cleaned");
      } catch (cleanupError) {
        console.error("⚠️ Temporary cleanup error:", cleanupError.message);
      }
    }

    collegeBulkRunningChats.delete(chatId);

    const state = userState.get(chatId);

    if (state) {
      state.collegeBulkRunning = false;
      state.collegeBulkCompletedAt = Date.now();

      userState.set(chatId, state);
    }
  }
}

/* =========================================================
   RESULT CHECK FLOW
   Session → Exam Type → Category (UGT/UGV/PGT/PGV) → Course → Roll
========================================================= */

async function startResultProcess(chatId) {
  try {
    await clearResultProcess(chatId);

    userState.set(chatId, {
      mode: "result",
      step: "session",
      session: null,
      examType: null,
      courseType: null,
      course: null,
      roll: null,
      rollAttempts: 0,
      messageId: null,
    });

    return showSessions(chatId);
  } catch (error) {
    console.error("Start result process error:", error);

    await clearResultProcess(chatId);

    return bot.sendMessage(
      chatId,
      "❌ <b>Unable to Start</b>\nThe result check could not be started. Please try again shortly.",
      {
        parse_mode: "HTML",
        ...(isOwner(chatId) ? ownerMenu() : mainMenu(chatId)),
      }
    );
  }
}

async function showSessions(chatId) {
  try {
    const state = userState.get(chatId);

    if (!state) {
      return startResultProcess(chatId);
    }

    state.step = "session";

    userState.set(chatId, state);

    const sessions = await getSessionsCached();

    if (!sessions.length) {
      throw new Error("No sessions are currently available.");
    }

    const buttons = colorRows(
      sessions.map((session) => ({
        text:
          state.session === session.value
            ? `✅ ${session.text}`
            : session.text,
        callback_data: "SESSION_" + encodeValue(session.value),
      }))
    );

    buttons.push(navRow("BACK_SESSION"));

    return replaceCurrentMessage(
      chatId,
      `📅 <b>Step 1 of 5 — Select Session</b>

<b>Selected Details</b>
📅 Session: <i>Not selected</i>

Please choose your examination session.`,
      {
        parse_mode: "HTML",
        reply_markup: {
          inline_keyboard: buttons,
        },
      }
    );
  } catch (error) {
    console.error("Session error:", error);

    await clearResultProcess(chatId);

    return bot.sendMessage(
      chatId,
      "❌ <b>Sessions Unavailable</b>\nThe list of sessions could not be loaded. Please try again shortly.",
      {
        parse_mode: "HTML",
        ...mainMenu(chatId),
      }
    );
  }
}

async function showExamTypes(chatId, session) {
  try {
    const state = userState.get(chatId);

    if (!state) {
      return startResultProcess(chatId);
    }

    state.step = "exam";

    userState.set(chatId, state);

    console.log("======================================");
    console.log("🔎 Loading Exam Types");
    console.log("Session:", session);
    console.log("======================================");

    const exams = await getExamTypesCached(session);

    if (!exams.length) {
      throw new Error("No examination types are available for this session.");
    }

    const buttons = colorRows(
      exams.map((exam) => ({
        text: state.examType === exam.value ? `✅ ${exam.text}` : exam.text,
        callback_data: "EXAM_" + encodeValue(exam.value),
      }))
    );

    buttons.push(navRow("BACK_SESSION"));

    return replaceCurrentMessage(
      chatId,
      `🎓 <b>Step 2 of 5 — Select Exam Type</b>

<b>Selected Details</b>
📅 Session: <b>${escapeHtml(session)}</b>
🎓 Exam Type: <i>Not selected</i>

Please choose the examination type.`,
      {
        parse_mode: "HTML",
        reply_markup: {
          inline_keyboard: buttons,
        },
      }
    );
  } catch (error) {
    console.error("Exam error:", error);

    await clearResultProcess(chatId);

    return bot.sendMessage(
      chatId,
      "❌ <b>Exam Types Unavailable</b>\nThe list of exam types could not be loaded. Please try again shortly.",
      {
        parse_mode: "HTML",
        ...mainMenu(chatId),
      }
    );
  }
}

async function showCourseTypes(chatId, session, examType) {
  const state = userState.get(chatId);

  if (!state) {
    return startResultProcess(chatId);
  }

  state.step = "coursetype";

  userState.set(chatId, state);

  const buttons = COURSE_TYPES.map((c) => ({
    text: `${state.courseType === c.code ? "✅ " : ""}${c.code} — ${c.label}`,
    callback_data: "CTYPE_" + c.code,
  }));

  // 2 x 2 grid: UG row in one colour, PG row in another
  const keyboard = [
    buttons.slice(0, 2).map((b) => ({ ...b, style: "primary" })),
    buttons.slice(2, 4).map((b) => ({ ...b, style: "success" })),
    navRow("BACK_EXAM"),
  ];

  return replaceCurrentMessage(
    chatId,
    `🏷️ <b>Step 3 of 5 — Select Category</b>

<b>Selected Details</b>
📅 Session: <b>${escapeHtml(session)}</b>
🎓 Exam Type: <b>${escapeHtml(examType)}</b>
🏷️ Category: <i>Not selected</i>

Please choose the course category.`,
    {
      parse_mode: "HTML",
      reply_markup: {
        inline_keyboard: keyboard,
      },
    }
  );
}

async function showCourses(chatId, session, examType) {
  try {
    const state = userState.get(chatId);

    if (!state) {
      return startResultProcess(chatId);
    }

    state.step = "course";

    userState.set(chatId, state);

    console.log("======================================");
    console.log("🔎 Loading Courses");
    console.log("Session:", session);
    console.log("Exam Type:", examType);
    console.log("Category:", state.courseType || "-");
    console.log("======================================");

    let courses = await getCoursesCached(session, examType);

    if (!courses.length) {
      throw new Error("No courses are available for this selection.");
    }

    let categoryNote = "";

    if (state.courseType) {
      const filtered = courses.filter(
        (course) => classifyCourse(course.text) === state.courseType
      );

      if (filtered.length) {
        courses = filtered;
      } else {
        categoryNote =
          "\n\nℹ️ No courses matched the selected category, so all available courses are shown.";
      }
    }

    const buttons = colorRows(
      courses.map((course) => ({
        text:
          state.course === course.value ? `✅ ${course.text}` : course.text,
        callback_data: "COURSE_" + encodeValue(course.value),
      }))
    );

    buttons.push(navRow("BACK_CTYPE"));

    return replaceCurrentMessage(
      chatId,
      `📚 <b>Step 4 of 5 — Select Course / Semester</b>

<b>Selected Details</b>
📅 Session: <b>${escapeHtml(session)}</b>
🎓 Exam Type: <b>${escapeHtml(examType)}</b>
🏷️ Category: ${
        state.courseType
          ? `<b>${escapeHtml(courseTypeLabel(state.courseType) || state.courseType)}</b>`
          : "<i>Not selected</i>"
      }
📚 Course: <i>Not selected</i>

Please choose your course or semester.${categoryNote}`,
      {
        parse_mode: "HTML",
        reply_markup: {
          inline_keyboard: buttons,
        },
      }
    );
  } catch (error) {
    console.error("Course error:", error);

    await clearResultProcess(chatId);

    return bot.sendMessage(
      chatId,
      "❌ <b>Courses Unavailable</b>\nThe list of courses could not be loaded. Please try again shortly.",
      {
        parse_mode: "HTML",
        ...mainMenu(chatId),
      }
    );
  }
}

async function showRollNumber(chatId, extraText = "") {
  const state = userState.get(chatId);

  if (!state) {
    return startResultProcess(chatId);
  }

  state.step = "roll";

  state.roll = null;

  userState.set(chatId, state);

  const retryText = extraText ? `\n\n${extraText}` : "";

  return replaceCurrentMessage(
    chatId,
    `🧾 <b>Step 5 of 5 — Enter Roll Number</b>

${selectedDetails(state)}

Please send your university roll number (numeric).

Example:
<code>2520631020001</code>${retryText}`,
    {
      parse_mode: "HTML",
      ...navigationButtons("BACK_COURSE"),
    }
  );
}

async function sendCheckingMessage(chatId, state, roll) {
  if (state.messageId) {
    await deleteBotMessage(chatId, state.messageId);

    state.messageId = null;
  }

  const sent = await bot.sendMessage(
    chatId,
    `🔍 <b>Retrieving Your Result</b>

${selectedDetails(state)}
🧾 Roll Number: <code>${escapeHtml(roll)}</code>

⏳ Please wait a moment...`,
    {
      parse_mode: "HTML",
    }
  );

  state.messageId = sent.message_id;

  userState.set(chatId, state);

  return sent;
}

async function safeAnswerCallback(query, text = "") {
  try {
    await bot.answerCallbackQuery(query.id, text ? { text } : {});
  } catch (_) {}
}

function isBulkCallback(data) {
  return (
    data === "BULK_SUBJECT" ||
    data === "BULK_SUBJECT_SESSION" ||
    data === "BULK_SUBJECT_EXAM" ||
    data === "BULK_SUBJECT_COURSE" ||
    data.startsWith("BULKS_") ||
    data.startsWith("BULKE_") ||
    data.startsWith("BULKC_") ||
    data === "BULK_COLLEGE" ||
    data.startsWith("COLLEGE_") ||
    data.startsWith("BULKCS_") ||
    data.startsWith("BULKCE_") ||
    data.startsWith("BULKCC_") ||
    data === "BULK_COLLEGE_SESSION" ||
    data === "BULK_COLLEGE_EXAM" ||
    data === "BULK_COLLEGE_COURSE" ||
    data === "BULK_MENU" ||
    data === "BULK_CANCEL"
  );
}

/* =========================================================
   BULK SUBJECT — direct open (used by /bulksubject + button)
========================================================= */

async function openBulkSubject(chatId, userId) {
  if (collegeBulkRunningChats.has(chatId)) {
    return bot.sendMessage(chatId, MSG.bulkRunning, { parse_mode: "HTML" });
  }

  // clear old message/state
  await clearResultProcess(chatId);

  // fresh bulk-subject state
  userState.set(chatId, {
    mode: "bulk",
    bulkType: "subject",
    bulkStep: "session",
    ownerId: String(userId),
    messageId: null,
    bulkMessageId: null,
  });

  // subject.js: start() = "Subject / College" type menu (it returns to this button - loop),
  // startSubject() = Step 1 "Select Session". The Subject button needs startSubject.
  const entry =
    typeof bulkSubject.startSubject === "function"
      ? "startSubject"
      : typeof bulkSubject.start === "function"
      ? "start"
      : null;

  if (!entry) {
    return bot.sendMessage(
      chatId,
      "❌ <b>Module Unavailable</b>\nThe subject bulk module is not available.",
      { parse_mode: "HTML" }
    );
  }

  try {
    const result = await bulkSubject[entry](bot, userState, chatId);

    return result;
  } catch (error) {
    console.error(`❌ Subject bulk ${entry}() failed:`, error);

    return bot.sendMessage(
      chatId,
      `❌ <b>Subject Bulk Could Not Start</b>\n<code>${escapeHtml(
        String(error.message || error).slice(0, 300)
      )}</code>`,
      { parse_mode: "HTML" }
    );
  }
}

bot.on("callback_query", async (query) => {
  const data = String(query?.data || "");

  const chatId = query?.message?.chat?.id;

  if (!chatId) {
    await safeAnswerCallback(query);
    return;
  }
  if (isRateLimited(query.from?.id, 40, 60 * 1000, "cb")) {
    await safeAnswerCallback(query, "Please slow down a little.");
    return;
  }
  if (isBulkCallback(data)) {
  if (!isBulkAllowed(query.from?.id)) {
    await safeAnswerCallback(
      query,
      "Please complete your profile setup first."
    );
    return;
  }

    try {
      if (data === "BULK_MENU") {
        await safeAnswerCallback(query);

        const oldState = userState.get(chatId);

        if (oldState?.messageId) {
          await deleteBotMessage(chatId, oldState.messageId);
        }

        userState.set(chatId, {
          mode: "bulk",
          bulkType: null,
          bulkStep: "menu",
          ownerId: String(query.from.id),
          messageId: null,
          bulkMessageId: null,
        });

        return bot.sendMessage(
          chatId,
          "📦 <b>Bulk Result</b>\n\nPlease choose a bulk mode.",
          {
            parse_mode: "HTML",
            ...bulkMenu(),
          }
        );
      }

      if (data === "BULK_SUBJECT") {
        await safeAnswerCallback(query);
        return await openBulkSubject(chatId, query.from.id);
      }

      if (data === "BULK_COLLEGE") {
        await safeAnswerCallback(query);

        const state = userState.get(chatId) || {};

        state.mode = "bulk";
        state.bulkType = "college";
        state.ownerId = String(query.from.id);
        state.messageId = null;
        state.collegeBulkRunning = false;

        userState.set(chatId, state);

        if (typeof bulkCollege.start === "function") {
          return await bulkCollege.start(bot, userState, chatId);
        }

        return bot.sendMessage(
          chatId,
          "❌ <b>Module Unavailable</b>\nThe college bulk module is not available.",
          { parse_mode: "HTML" }
        );
      }

      if (
        data.startsWith("BULKS_") ||
        data.startsWith("BULKE_") ||
        data.startsWith("BULKC_") ||
        data === "BULK_SUBJECT_SESSION" ||
        data === "BULK_SUBJECT_EXAM" ||
        data === "BULK_SUBJECT_COURSE"
      ) {
        await safeAnswerCallback(query);

        const subjectResult = await bulkSubject.handleCallback(
          bot,
          userState,
          chatId,
          data
        );

        return subjectResult;
      }

      if (
        data.startsWith("COLLEGE_") ||
        data.startsWith("BULKCS_") ||
        data.startsWith("BULKCE_") ||
        data.startsWith("BULKCC_") ||
        data === "BULK_COLLEGE_SESSION" ||
        data === "BULK_COLLEGE_EXAM" ||
        data === "BULK_COLLEGE_COURSE"
      ) {
        await safeAnswerCallback(query);

        const result = await bulkCollege.handleCallback(bot, userState, query);

        if (result?.action === "start") {
          if (collegeBulkRunningChats.has(chatId)) {
            return bot.sendMessage(chatId, MSG.bulkRunning, {
              parse_mode: "HTML",
            });
          }

          const jobs = Array.isArray(result.jobs) ? result.jobs : [];

          if (!jobs.length) {
            return bot.sendMessage(
              chatId,
              "❌ <b>No Jobs Generated</b>\nNo valid college bulk jobs could be created from the selection.",
              { parse_mode: "HTML" }
            );
          }

          collegeBulkRunningChats.add(chatId);

          const state = userState.get(chatId);

          if (state) {
            state.collegeBulkRunning = true;
            state.ownerId = String(query.from.id);

            userState.set(chatId, state);
          }

          runCollegeBulkSearch(chatId, jobs).catch((error) => {
            console.error("❌ College bulk background error:", error);
          });

          return;
        }

        return result;
      }

      if (data === "BULK_CANCEL") {
        await safeAnswerCallback(query);

        await clearResultProcess(chatId);

        return bot.sendMessage(chatId, "❌ <b>Bulk process cancelled.</b>", {
          parse_mode: "HTML",
          ...ownerMenu(),
        });
      }

      // Fallback: bulk buttons not covered by the prefix lists above.
      // If this chat's bulk mode is "subject", hand them to subject.js (roll range, start, back, etc.).
      if (/^BULK/.test(data)) {
        const bulkState = userState.get(chatId);

        if (bulkState?.bulkType === "subject") {
          await safeAnswerCallback(query);

          const fallbackResult = await bulkSubject.handleCallback(
            bot,
            userState,
            chatId,
            data
          );

          return fallbackResult;
        }
      }
    } catch (error) {
      console.error("Bulk callback error:", error);

      await safeAnswerCallback(query, "Something went wrong.");

      return bot.sendMessage(
        chatId,
        "❌ <b>Bulk Result Error</b>\nPlease start again using /bulk.",
        {
          parse_mode: "HTML",
          ...ownerMenu(),
        }
      );
    }

    return;
  }

  try {
    await safeAnswerCallback(query);

    if (data === "MAIN_MENU") {
      await clearResultProcess(chatId);

      return bot.sendMessage(
        chatId,
        "🏠 <b>Main Menu</b>\n\nPlease choose an option below.",
        {
          parse_mode: "HTML",
          ...(isOwner(query.from?.id) ? ownerMenu() : mainMenu(chatId)),
        }
      );
    }

    if (data === "PROFILE_SETUP") {
      return startProfileSetup(chatId, query.from);
    }

    if (data === "PROFILE_CANCEL") {
      await clearResultProcess(chatId);

      return bot.sendMessage(chatId, "❌ <b>Profile setup cancelled.</b>", {
        parse_mode: "HTML",
        ...(isOwner(query.from?.id) ? ownerMenu() : mainMenu(chatId)),
      });
    }

    if (data === "MY_PROFILE") {
      return showMyProfile(chatId, query.from?.id);
    }

    if (data === "MY_LOCKER") {
      return openMyLocker(chatId, query.from?.id, query.from);
    }

    if (data === "DELPROFILE_ASK") {
      return askDeleteProfile(chatId, query.from?.id);
    }

    if (data === "DELPROFILE_NO") {
      await deleteBotMessage(chatId, query.message?.message_id);

      return bot.sendMessage(
        chatId,
        "👍 <b>No changes made.</b>\nYour profile has been kept.",
        {
          parse_mode: "HTML",
          ...(isOwner(query.from?.id) ? ownerMenu() : mainMenu(chatId)),
        }
      );
    }

    if (data === "DELPROFILE_YES") {
      if (isRateLimited(query.from?.id, 3, 60 * 1000, "delprofile")) {
        return;
      }

      await deleteBotMessage(chatId, query.message?.message_id);

      return confirmDeleteProfile(chatId, query.from?.id);
    }

    if (data === "CHECK_RESULT" || data === "CHECK_ANOTHER") {
      if (
        OWN_ROLL_ONLY &&
        !isOwner(query.from?.id) &&
        !profiles.getByTelegramId(query.from?.id)
      ) {
        return startProfileSetup(chatId, query.from);
      }

      return startResultProcess(chatId);
    }

    if (data === "CANCEL_RESULT") {
      await clearResultProcess(chatId);

      return bot.sendMessage(chatId, "❌ <b>Result check cancelled.</b>", {
        parse_mode: "HTML",
        ...(isOwner(query.from?.id) ? ownerMenu() : mainMenu(chatId)),
      });
    }

        if (data === "HELP") {
      const guide =
        "\n\n📖 <b>Guide</b>\n" +
        "🧾 <b>Profile Setup</b>\n" +
         "Apne 13-digit roll number se profile banayein.\n" +

        "👤 <b>My Profile</b> \n" +
        "Apni profile details dekhein.\n" +

        "🔐 <b>My Locker</b> \n" +
        "Apne saare semester / year ke available results ek saath paayein.\n" +

        "📊 <b>Check Result</b>\n" +
        "Session, exam type, category aur course chunkar result paayein.\n"

      return bot.sendMessage(
        chatId,
        buildCommandList(query.from?.id) + guide,
        {
          parse_mode: "HTML",
          disable_web_page_preview: true,
          ...(isOwner(query.from?.id)
            ? ownerMenu()
            : profiles.getByTelegramId(query.from?.id)
            ? mainMenu(chatId)
            : newUserMenu()),
        }
      );
    }

    if (data === "BACK_SESSION") {
      return showSessions(chatId);
    }

    if (data === "BACK_EXAM") {
      const state = userState.get(chatId);

      return state?.session
        ? showExamTypes(chatId, state.session)
        : showSessions(chatId);
    }

    if (data === "BACK_CTYPE") {
      const state = userState.get(chatId);

      return state?.session && state?.examType
        ? showCourseTypes(chatId, state.session, state.examType)
        : showSessions(chatId);
    }

    if (data === "BACK_COURSE") {
      const state = userState.get(chatId);

      return state?.session && state?.examType
        ? showCourses(chatId, state.session, state.examType)
        : showSessions(chatId);
    }

    if (data.startsWith("SESSION_")) {
      const session = decodeValue(data.slice("SESSION_".length));

      const state = userState.get(chatId);

      if (!state) {
        return startResultProcess(chatId);
      }

      state.session = session;
      state.examType = null;
      state.courseType = null;
      state.course = null;
      state.roll = null;
      state.rollAttempts = 0;

      userState.set(chatId, state);

      return showExamTypes(chatId, session);
    }

    if (data.startsWith("EXAM_")) {
      const examType = decodeValue(data.slice("EXAM_".length));

      const state = userState.get(chatId);

      if (!state || !state.session) {
        return startResultProcess(chatId);
      }

      state.examType = examType;
      state.courseType = null;
      state.course = null;
      state.roll = null;
      state.rollAttempts = 0;

      userState.set(chatId, state);

      return showCourseTypes(chatId, state.session, examType);
    }

    if (data.startsWith("CTYPE_")) {
      const code = data.slice("CTYPE_".length);

      const state = userState.get(chatId);

      if (!state || !state.session || !state.examType) {
        return startResultProcess(chatId);
      }

      if (!COURSE_TYPES.some((c) => c.code === code)) {
        return showCourseTypes(chatId, state.session, state.examType);
      }

      state.courseType = code;
      state.course = null;
      state.roll = null;
      state.rollAttempts = 0;

      userState.set(chatId, state);

      return showCourses(chatId, state.session, state.examType);
    }

    if (data.startsWith("COURSE_")) {
      const course = decodeValue(data.slice("COURSE_".length));

      const state = userState.get(chatId);

      if (!state || !state.session || !state.examType) {
        return startResultProcess(chatId);
      }

      state.course = course;
      state.roll = null;
      state.rollAttempts = 0;

      userState.set(chatId, state);

      if (OWN_ROLL_ONLY && !isOwner(query.from?.id)) {
        const ownProfile = profiles.getByTelegramId(query.from?.id);

        if (!ownProfile) {
          return startProfileSetup(chatId, query.from);
        }

        if (
          isRateLimited(
            query.from?.id,
            Number(process.env.RESULT_RATE_LIMIT || 5)
          )
        ) {
          return bot.sendMessage(chatId, MSG.rateLimited, {
            parse_mode: "HTML",
          });
        }

        return runRollCheck(chatId, state, ownProfile.roll, query.from?.id);
      }

      return showRollNumber(chatId);
    }
  } catch (error) {
    console.error("Callback error:", error);

    try {
      await bot.sendMessage(chatId, MSG.genericError, {
        parse_mode: "HTML",
        ...(isOwner(query.from?.id) ? ownerMenu() : mainMenu(chatId)),
      });
    } catch (_) {}
  }
});

function newUserMenu() {
  return {
    reply_markup: {
      inline_keyboard: [
        [
          { text: "🧾 Profile Setup", callback_data: "PROFILE_SETUP", style: "success" },
          { text: "ℹ️ Help", callback_data: "HELP", style: "primary" },
        ],
      ],
    },
  };
}

bot.onText(/^\/start(?:@\w+)?$/, async (msg) => {
  const chatId = msg.chat.id;
  const userId = msg.from?.id ?? chatId;

  try {
    await clearResultProcess(chatId);

    const profile = profiles.getByTelegramId(userId);

    // New user (no profile, not owner): sirf profile setup ka msg + 2 buttons
    if (!profile && !isOwner(userId)) {
      return bot.sendMessage(
        chatId,
        "🎓 <b>PPU Result Bot</b>\n\n" +
          "<b>Welcome!</b> Create your student profile to recieve your results marksheet quickly.\n\n" +
          "Tap <b>Profile Setup'</b> and Enter your <b>13-Digit University Roll Number</b> (printed on your admit card) .",
        {
          parse_mode: "HTML",
          ...newUserMenu(),
        }
      );
    }

    // Existing user / owner: pehle jaisa
    const greeting = profile
      ? `👋 <b>Welcome back, ${escapeHtml(
          profile.name || "Student"
        )}</b>\n\nYour student profile is ready. Please choose an option below.`
      : "🎓 <b>PPU Result Bot</b>\n\nPlease choose an option below.";

    await bot.sendMessage(chatId, buildCommandList(userId), {
      parse_mode: "HTML",
      disable_web_page_preview: true,
    });

    return bot.sendMessage(chatId, greeting, {
      parse_mode: "HTML",
      ...(isOwnerMessage(msg) ? ownerMenu() : mainMenu(chatId)),
    });
  } catch (error) {
    console.error("/start error:", error);
  }
});

bot.onText(/^\/profilesetup(?:@\w+)?$/i, (msg) =>
  startProfileSetup(msg.chat.id, msg.from)
);

bot.onText(/^\/resetroll(?:@\w+)?$/i, (msg) =>
  startRollReset(msg.chat.id, msg.from)
);

bot.onText(/^\/myprofile(?:@\w+)?$/i, (msg) =>
  showMyProfile(msg.chat.id, msg.from?.id)
);

bot.onText(/^\/delprofile(?:@\w+)?$/i, (msg) =>
  askDeleteProfile(msg.chat.id, msg.from?.id)
);

bot.onText(/^\/locker(?:@\w+)?$/i, (msg) =>
  openMyLocker(msg.chat.id, msg.from?.id, msg.from)
);

bot.onText(/^\/(free|unfree)(?:@\w+)?$/i, async (msg, match) => {
  const chatId = msg.chat.id;

  if (!isOwnerMessage(msg)) {
    return bot.sendMessage(chatId, MSG.ownerOnly, {
      parse_mode: "HTML",
    });
  }

  const command = String(match?.[1] || "").toLowerCase();
  const newValue = command === "free";

  COLLEGE_BULK_OPEN = newValue;
  process.env.COLLEGE_BULK_OPEN = String(newValue);

  const envPath = path.join(__dirname, ".env");

  try {
    let envText = fs.existsSync(envPath)
      ? fs.readFileSync(envPath, "utf8")
      : "";

    const line = `COLLEGE_BULK_OPEN=${newValue}`;

    if (/^COLLEGE_BULK_OPEN=.*$/m.test(envText)) {
      envText = envText.replace(/^COLLEGE_BULK_OPEN=.*$/m, line);
    } else {
      envText = envText.trimEnd() + `\n${line}\n`;
    }

    fs.writeFileSync(envPath, envText, "utf8");

    return bot.sendMessage(
      chatId,
      newValue
        ? "🟢 <b>College Bulk is now FREE</b>\n\nNormal users with a profile can now see and use College Bulk."
        : "🔴 <b>College Bulk is now UNFREE</b>\n\nCollege Bulk is now hidden from normal users.",
      {
        parse_mode: "HTML",
      }
    );
  } catch (error) {
    console.error("College Bulk setting update error:", error);

    return bot.sendMessage(
      chatId,
      "❌ <b>Setting Update Failed</b>\n\nCollege Bulk setting could not be updated.",
      {
        parse_mode: "HTML",
      }
    );
  }
});

  if (!isOwnerMessage(msg)) {
    return bot.sendMessage(chatId, MSG.ownerOnly, { parse_mode: "HTML" });
  }

  const newValue = String(match?.[1] || "").toLowerCase() === "true";

  BULK_OWNER_ONLY = newValue;
 bot.onText(/^\/(free|unfree)(?:@\w+)?$/i, async (msg, match) => {
