/* =========================================================
   USER STATE (auto-expiring) + RATE LIMIT
========================================================= */

class ExpiringMap extends Map {
  constructor(ttlMs, isProtected = () => false) {
    super();
    this.ttlMs = ttlMs;
    this.isProtected = isProtected;
    this.stamps = new Map();
  }

  set(key, value) {
    this.stamps.set(key, Date.now());
    return super.set(key, value);
  }

  get(key) {
    const stamp = this.stamps.get(key);
    if (
      stamp &&
      Date.now() - stamp > this.ttlMs &&
      !this.isProtected(key)
    ) {
      this.delete(key);
      return undefined;
    }
    return super.get(key);
  }

  delete(key) {
    this.stamps.delete(key);
    return super.delete(key);
  }

  sweep() {
    for (const [key, stamp] of this.stamps) {
      if (Date.now() - stamp > this.ttlMs && !this.isProtected(key)) {
        this.delete(key);
      }
    }
  }
}

// A running college-bulk job keeps its state alive.
const userState = new ExpiringMap(
  Math.max(5, Number(process.env.STATE_TTL_MIN || 60)) * 60 * 1000,
  (chatId) => collegeBulkRunningChats.has(chatId)
);
setInterval(() => userState.sweep(), 5 * 60 * 1000).unref();

const rateBuckets = new Map();

function isRateLimited(userId, max = 5, windowMs = 60 * 1000, bucket = "main") {
  if (OWNER_IDS.has(String(userId))) return false;

  const key = `${bucket}:${userId}`;
  const now = Date.now();
  const hits = (rateBuckets.get(key) || []).filter((t) => now - t < windowMs);
  hits.push(now);
  rateBuckets.set(key, hits);
  return hits.length > max;
}
setInterval(() => rateBuckets.clear(), 10 * 60 * 1000).unref();

