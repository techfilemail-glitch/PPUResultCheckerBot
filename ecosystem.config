// pm2 start ecosystem.config.js && pm2 save
module.exports = {
  apps: [
    {
      name: "ppu-bot",
      script: "index.js",
      max_memory_restart: "800M",
      exp_backoff_restart_delay: 200,
      kill_timeout: 12000, // lets index.js finish its graceful shutdown
      time: true,
    },
  ],
};
 
